/* SentinelAI Supreme UI - Qt6 Standardization */
QWidget {
    background-color: #0a0a0a;
    color: #00ff00;
    font-family: 'Courier New', monospace;
    font-size: 14px;
}

QPushButton {
    background-color: #111;
    border: 1px solid #00ff00;
    color: #00ff00;
    padding: 8px 16px;
    border-radius: 3px;
}

QPushButton:hover {
    background-color: #00ff00;
    color: #000;
}

QLineEdit, QTextEdit {
    background-color: #111;
    border: 1px solid #333;
    color: #00ff00;
    padding: 5px;
}

QPanel {
    border: 1px solid #333;
    background-color: #0d0d0d;
}
