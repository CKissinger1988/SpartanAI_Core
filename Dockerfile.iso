# NEXUS // AI - CNSA ISO Factory
FROM kalilinux/kali-rolling

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install core build tools and live-build
RUN apt-get update && apt-get install -y \
    live-build \
    debootstrap \
    squashfs-tools \
    xorriso \
    syslinux \
    syslinux-utils \
    curl \
    git \
    python3 \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Set working directory for the ISO build
WORKDIR /opt/nexus-iso-build

# 1. Initialize live-build configuration
RUN lb config \
    --binary-images iso-hybrid \
    --distribution kali-rolling \
    --bootloader syslinux \
    --archive-areas "main contrib non-free non-free-firmware"

# 2. Copy the project source into the chroot includes
# This ensures the project is baked into /opt/nexus-ai in the final ISO
COPY . config/includes.chroot/opt/nexus-ai/

# 3. Synchronize custom configurations
# (This assumes the local kali-config/ folder is copied)
COPY kali-config/config/ config/

# Operational instructions for the user
CMD ["lb", "build"]
